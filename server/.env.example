DATABASE_URL="postgresql://gw2logs:changeme@localhost:5432/gw2logs?schema=public"
PORT=4000

# Discord application (https://discord.com/developers/applications) — OAuth2 tab.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:4000/api/auth/discord/callback

# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=change-me-to-a-random-64-char-hex-string

# Comma-separated Discord user ids (right-click your name in Discord with
# Developer Mode on -> Copy User ID) that get admin access on login.
# Survives DB resets without manual SQL — see routes/auth.ts.
ADMIN_DISCORD_IDS=

