generator client {
  provider      = "prisma-client-js"
  // Bundle engines for both OpenSSL versions seen across Debian-based node
  // images in practice (native alone proved unreliable — the exact version
  // the build stage detects doesn't always match the runtime stage's).
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Player {
  id          String      @id @default(cuid())
  account     String      @unique
  displayName String
  createdAt   DateTime    @default(now())
  logPlayers  LogPlayer[]
  userId      String?     @unique
  user        User?       @relation(fields: [userId], references: [id])
}

model User {
  id              String            @id @default(cuid())
  discordId       String            @unique
  discordUsername String
  discordAvatar   String?
  gw2AccountName  String?           @unique
  gw2ApiKeyEnc    String?
  gw2LinkedAt     DateTime?
  createdAt       DateTime          @default(now())
  sessions        Session[]
  guildMemberships GuildMembership[]
  player          Player?
  compositions    Composition[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Guild {
  id           String            @id @default(cuid())
  gw2GuildId   String            @unique
  name         String
  tag          String
  lastSyncedAt DateTime          @default(now())
  memberships  GuildMembership[]
  compositions Composition[]
}

model GuildMembership {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  guildId   String
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  isLeader  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([userId, guildId])
}

model Log {
  id             String          @id @default(cuid())
  contentHash    String          @unique
  fightName      String
  triggerId      Int?
  wing           String?
  isCm           Boolean         @default(false)
  success        Boolean
  durationMs     Int
  squadDps       Int
  encounterTime  DateTime
  uploadedAt     DateTime        @default(now())
  uploadedBy     String?
  sourceFileName String?
  rawJson        Json
  players        LogPlayer[]
  mechanicEvents MechanicEvent[]

  @@index([fightName, isCm])
  @@index([uploadedAt])
}

model LogPlayer {
  id            String   @id @default(cuid())
  logId         String
  log           Log      @relation(fields: [logId], references: [id], onDelete: Cascade)
  playerId      String
  player        Player   @relation(fields: [playerId], references: [id])
  characterName String
  profession    String
  spec          String
  subgroup      Int
  totalDps      Int
  powerDps      Int
  condiDps      Int
  damageTaken   Int
  downCount     Int
  deadCount     Int
  boons         Json
  mechanics     Json

  @@index([logId])
  @@index([playerId])
  @@index([profession])
}

model MechanicEvent {
  id     String @id @default(cuid())
  logId  String
  log    Log    @relation(fields: [logId], references: [id], onDelete: Cascade)
  timeMs Int
  name   String
  actor  String?

  @@index([logId])
}

model Composition {
  id          String            @id @default(cuid())
  guildId     String
  guild       Guild             @relation(fields: [guildId], references: [id], onDelete: Cascade)
  name        String
  fightName   String?
  createdById String
  createdBy   User              @relation(fields: [createdById], references: [id])
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  slots       CompositionSlot[]

  @@index([guildId])
}

model CompositionSlot {
  id            String      @id @default(cuid())
  compositionId String
  composition   Composition @relation(fields: [compositionId], references: [id], onDelete: Cascade)
  subgroup      Int
  slotIndex     Int
  role          String
  profession    String
  spec          String?
  buildName     String?
  buildDetails  String?

  @@unique([compositionId, subgroup, slotIndex])
}

model UploadJob {
  id           String   @id @default(cuid())
  status       String // queued | parsing | success | failed
  fileName     String
  fileSizeByte Int
  errorMessage String?
  logId        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
