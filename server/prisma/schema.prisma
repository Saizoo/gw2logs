generator client {
  provider      = "prisma-client-js"
  // Bundle engines for both OpenSSL versions seen across Debian-based node
  // images in practice (native alone proved unreliable — the exact version
  // the build stage detects doesn't always match the runtime stage's).
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// The raid-planner build catalog, admin-editable. `id` is kept as the
// path-derived string the static catalog always used (e.g.
// "elementalist/celestial-alacrity-tempest-scepter-warhorn"), not a cuid —
// existing CompositionSlot.buildId values already reference these exact
// strings, and preserving them means the migration from the static file
// doesn't orphan any composition a user has already saved.
model Build {
  id         String   @id
  profession String
  category   String
  name       String
  weapons    String
  url        String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([profession])
}

model Player {
  id          String      @id @default(cuid())
  account     String      @unique
  displayName String
  createdAt   DateTime    @default(now())
  logPlayers  LogPlayer[]
  userId      String?     @unique
  user        User?       @relation(fields: [userId], references: [id])
}

model User {
  id               String         @id @default(cuid())
  discordId        String         @unique
  discordUsername  String
  discordAvatar    String?
  gw2AccountName   String?        @unique
  gw2ApiKeyEnc     String?
  gw2LinkedAt      DateTime?
  // dps.report auto-import: the user's dps.report userToken (encrypted at rest,
  // same scheme as gw2ApiKeyEnc). When set, a background poller periodically
  // pulls that token's newly-uploaded logs into gw2logs. linkedAt marks when
  // it was connected; lastImportAt is the newest upload time seen so the poller
  // can stop early instead of re-walking the whole history each tick.
  dpsReportTokenEnc    String?
  dpsReportLinkedAt    DateTime?
  dpsReportLastImportAt DateTime?
  createdAt        DateTime       @default(now())
  // Bootstrapped from ADMIN_DISCORD_IDS on login (see routes/auth.ts) so the
  // first admin exists without manual SQL after a DB reset; promotable/
  // demotable afterward from the admin panel itself.
  isAdmin          Boolean        @default(false)
  // When the first-login onboarding tour was completed (or skipped). Null
  // means the user has never seen it — the frontend shows the tour once.
  // Backfilled to the migration timestamp for accounts that existed before
  // the tour did, so it only ever triggers for genuinely new users.
  onboardedAt      DateTime?
  // Set when an admin suspends the account — suspended users keep their
  // rows but every authenticated request is rejected until unsuspended.
  suspendedAt      DateTime?
  // Privacy: when hideName is set, this user's account/character names are
  // masked (shown as "Anonymous") everywhere a log surfaces them —
  // leaderboards, benchmarks, log squad tables — while their parse numbers
  // still show. When privateProfile is set, their /players profile page is
  // only viewable by themselves (and admins). Both default off.
  hideName         Boolean        @default(false)
  privateProfile   Boolean        @default(false)
  // The spec or profession the user picked as their profile icon (e.g.
  // "Firebrand", "Guardian"). Drives both the profile-header icon and its
  // background banner art. Null falls back to their most-played profession.
  profileIcon      String?
  // The guild this user chose to represent (from the guilds on their GW2
  // account). Driving membership of the guild's auto-created group; null
  // means no guild displayed.
  displayedGuildId String?
  displayedGuild   Guild?         @relation("DisplayedGuild", fields: [displayedGuildId], references: [id], onDelete: SetNull)
  sessions         Session[]
  apiTokens        ApiToken[]
  player           Player?
  compositions     Composition[]
  characters       Character[]
  groupsLed        Group[]        @relation("GroupLeader")
  groupMemberships GroupMember[]
  groupRequests    GroupRequest[]
  raidSignups      RaidSignup[]
  auditActions     AdminAudit[]
  uploadedLogs     Log[]          @relation("LogUploader")
  announcements    Announcement[] @relation("AnnouncementAuthor")
  notifications    Notification[]
  invitesSent      GroupInvite[]  @relation("InviteSender")
  invitesReceived  GroupInvite[]  @relation("InviteTarget")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Personal access tokens for non-browser clients (the desktop / Nexus addon).
// Only the SHA-256 of the raw token is stored — the raw value is shown to the
// user once at creation and never again, same defense as Session. `id` is a
// separate public handle used to list/revoke a token without exposing its hash.
model ApiToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([userId])
}

model Log {
  id             String          @id @default(cuid())
  contentHash    String          @unique
  fightName      String
  triggerId      Int?
  wing           String?
  isCm           Boolean         @default(false)
  success        Boolean
  durationMs     Int
  squadDps       Int
  encounterTime  DateTime
  uploadedAt     DateTime        @default(now())
  // Null means anonymous — either uploaded while signed out, or uploaded
  // before this field existed. See routes/logs.ts POST /:id/claim for how
  // an anonymous log can be retroactively attributed.
  uploadedBy     String?
  uploader       User?           @relation("LogUploader", fields: [uploadedBy], references: [id], onDelete: SetNull)
  sourceFileName String?
  // Per-mechanic display metadata from Elite Insights, keyed by the mechanic's
  // short name: { [shortName]: { fullName, description } }. EI's Description is
  // the human-readable explanation shown on the Mechanics tab (what dps.report
  // surfaces on hover); shortName alone is a terse label. Null on logs ingested
  // before this was captured.
  mechanicsMeta  Json?
  // Boss health-over-time + phase breakdown, extracted from the Elite Insights
  // JSON at ingest and kept as a small blob (the raw dump itself is discarded):
  //   { bossName, totalHealth, health: [[timeMs, pct], ...],
  //     phases: [{ name, startMs, endMs, breakbar, squadDps }] }.
  // Null on logs ingested before this was captured — their raw JSON is gone,
  // so those can't be backfilled and the detail page shows "coming soon".
  phaseData      Json?
  // Uploader-controlled privacy. A private log is kept off the public browse
  // surfaces (All Reports list, search, recent feeds) and its detail page is
  // access-controlled — only the uploader, admins, and (if assigned) the
  // group's members can open it. Its parses still count in rankings/benchmarks
  // (see routes/logs.ts, encounters.ts). Only settable by a signed-in uploader.
  private        Boolean         @default(false)
  // Set by the uploader at upload time if they're a member of the group —
  // see routes/uploads.ts. Null means "not attached to any group", not
  // "unknown"; a log can only ever belong to one group.
  groupId        String?
  group          Group?          @relation(fields: [groupId], references: [id], onDelete: SetNull)
  // The full Elite Insights JSON dump used to live here, but at ~100MB+ per
  // raid log it was the entire storage cost of the database (15GB for 120
  // logs). Everything the app actually reads is extracted into LogPlayer/
  // MechanicEvent at ingest time — the raw dump itself is now discarded
  // right after normalizeEiJson() runs, never written to the DB.
  players        LogPlayer[]
  mechanicEvents MechanicEvent[]
  deathEvents    DeathEvent[]

  @@index([fightName, isCm])
  @@index([uploadedAt])
  @@index([uploadedBy])
  @@index([groupId])
  @@index([private])
}

model LogPlayer {
  id            String @id @default(cuid())
  logId         String
  log           Log    @relation(fields: [logId], references: [id], onDelete: Cascade)
  playerId      String
  player        Player @relation(fields: [playerId], references: [id])
  characterName String
  profession    String
  spec          String
  subgroup      Int
  totalDps      Int
  powerDps      Int
  condiDps      Int
  damageTaken   Int
  downCount     Int
  deadCount     Int
  boons         Json
  mechanics     Json
  // Per-log squad function, computed at ingest time from real EI signals —
  // subgroup boon *generation* (GroupBuffs) for alac/quick, plus outgoing
  // healing (EXTHealingStats) when the log was recorded with the healing
  // addon. Never derived from DPS magnitude: a boon-support DPS build and a
  // pure DPS both look like "not the top parse", and a low-DPS reading is
  // not evidence of a healer build on its own.
  squadRole     String @default("dps")
  // Subgroup boon generation %, same shape as `boons` but scoped to
  // GroupBuffs (what this player generated for their 5-person subgroup)
  // rather than BuffUptimes (personal uptime) — the signal squadRole is
  // computed from.
  groupBoons    Json?
  // Outgoing healing (HPS to allies), only present when the log's arcdps
  // capture included the healing addon. Null, not 0, when unavailable —
  // 0 would wrongly read as "healed for nothing" instead of "unknown".
  healingOutput Int?

  @@index([logId])
  @@index([playerId])
  @@index([profession])
}

model MechanicEvent {
  id       String  @id @default(cuid())
  logId    String
  log      Log     @relation(fields: [logId], references: [id], onDelete: Cascade)
  timeMs   Int
  name     String
  actor    String?
  // "Sev0".."Sev4" from Elite Insights' own Mechanics[].Severity — the only
  // classification EI provides for a mechanic (no icon/color-hex field
  // exists upstream). Denormalized onto every event row (rather than a
  // join back to a per-log mechanic-definition table) since it's the same
  // value for every instance of a given mechanic name within one log.
  severity String?

  @@index([logId])
}

// From JsonPlayer.DeathRecap — EI's own recap of each death, not something
// derived/guessed here. `killedBy` is DeathRecap.ToKill's last entry's
// `Src`, which EI already resolves to a display name (the actor or skill
// source of the killing hit) — no separate skill-id lookup needed for that
// part. Downs that didn't end in death aren't covered (EI only recaps
// actual deaths), and there's deliberately no separate "went down" event
// here for the same reason.
model DeathEvent {
  id       String  @id @default(cuid())
  logId    String
  log      Log     @relation(fields: [logId], references: [id], onDelete: Cascade)
  timeMs   Int
  actor    String
  killedBy String?

  @@index([logId])
}

// Ad-hoc raid-planning team, created and joined by request/invite,
// independent of in-game guild membership — the unit that owns saved
// squad compositions.
// One row per in-game guild that at least one user has chosen to display.
// The GW2 guild UUID is the primary key. Each guild owns exactly one
// auto-created Group (its "guild group") whose membership is driven by
// who displays the guild.
model Guild {
  id             String    @id
  name           String
  tag            String
  createdAt      DateTime  @default(now())
  // User whose API key has proven able to read this guild's members and
  // ranks (the GW2 API restricts those endpoints to the in-game guild
  // leader) — the key rank syncs run against.
  syncUserId     String?
  lastRankSyncAt DateTime?
  group          Group?
  displayedBy    User[]    @relation("DisplayedGuild")
}

model Group {
  id               String         @id @default(cuid())
  name             String
  leaderId         String
  leader           User           @relation("GroupLeader", fields: [leaderId], references: [id])
  icon             String?
  background       String?
  // Set on auto-created guild groups only — the marker that separates
  // them from hand-made statics. Guild groups keep every normal group
  // feature; membership and roles are additionally synced from the guild.
  guildId          String?        @unique
  guild            Guild?         @relation(fields: [guildId], references: [id], onDelete: SetNull)
  createdAt        DateTime       @default(now())
  members          GroupMember[]
  requests         GroupRequest[]
  compositions     Composition[]
  // Recurring raid schedule, set by a leader/subleader from the group page
  // and surfaced on group search so prospective members can filter for a
  // day that works for them. All optional/empty by default — a brand new
  // group has no schedule until someone sets one.
  raidDays         String[]       @default([])
  raidStartTime    String?
  raidDurationMins Int?
  raidTimezone     String?
  // A second recurring schedule for fractals, shown alongside the raid
  // schedule on the group page. Same shape as the raid fields; all
  // optional — a group without a fractal night simply leaves them empty.
  fractalDays         String[]    @default([])
  fractalStartTime    String?
  fractalDurationMins Int?
  fractalTimezone     String?
  logs             Log[]
  signups          RaidSignup[]
  // Discord webhook for raid-night reminders. Encrypted at rest like GW2
  // API keys — anyone holding the raw URL can post to the channel. Null
  // means reminders are off; raidReminderMins is how long before the
  // scheduled start time the reminder fires.
  discordWebhookEnc String?
  raidReminderMins  Int               @default(60)
  // Which group events get posted to the Discord webhook. Keys:
  // "reminder" (pre-raid RSVP tally), "schedule" (raid times changed),
  // "plan" (weekly raid plan published), "member" (someone joined),
  // "log" (a log was uploaded to this group). Empty means the webhook is
  // connected but silent.
  webhookEvents     String[]          @default(["reminder", "schedule", "plan", "log"])
  reminderLogs      RaidReminderLog[]
  weekPlanItems     GroupWeekPlanItem[]
  notifications     Notification[]
  invites           GroupInvite[]
}

// In-app notification for a single user. Group-related events (schedule
// change, published plan, pre-raid reminder, invites) fan out one row per
// recipient. `link` is an in-app path the bell dropdown navigates to.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  link      String?
  groupId   String?
  group     Group?    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

// A leader/subleader invite to join a group. Targets an existing user when
// one matches, otherwise holds a Discord username so the invite resolves the
// moment that person signs in for the first time.
model GroupInvite {
  id             String    @id @default(cuid())
  groupId        String
  group          Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  invitedById    String
  invitedBy      User      @relation("InviteSender", fields: [invitedById], references: [id], onDelete: Cascade)
  // Set once the invite is bound to a real account; null while it's still a
  // pending invite-by-Discord-name waiting for that person to sign up.
  targetUserId   String?
  targetUser     User?     @relation("InviteTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  discordUsername String?
  status         String    @default("pending") // pending | accepted | declined
  createdAt      DateTime  @default(now())
  respondedAt    DateTime?

  @@index([targetUserId, status])
  @@index([discordUsername, status])
}

// One planned fight on a group's "This Week" agenda. weekStart pins the
// plan to a GW2 reset week (Monday 07:30 UTC, stored as that Monday's
// YYYY-MM-DD) so last week's plan ages out on reset instead of lingering.
// The composition link is optional — a leader can outline the week's
// fights before assigning squads — and SetNull keeps the fight on the
// plan if its composition is later deleted from the planner.
model GroupWeekPlanItem {
  id            String       @id @default(cuid())
  groupId       String
  group         Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  weekStart     String
  // Weekday short name ("Mon".."Sun") the fight is scheduled on. Null =
  // not pinned to a day (legacy rows and "sometime this week" fights).
  day           String?
  order         Int
  encounterName String
  compositionId String?
  composition   Composition? @relation(fields: [compositionId], references: [id], onDelete: SetNull)
  note          String?
  createdAt     DateTime     @default(now())

  @@index([groupId, weekStart])
}

// One row per reminder actually sent, so a scheduler tick (or a restart
// mid-window) can never double-post the same raid night.
model RaidReminderLog {
  id      String   @id @default(cuid())
  groupId String
  group   Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  date    String // raid night, YYYY-MM-DD in the group's timezone
  // Which delivery channel this claim is for — the Discord webhook and the
  // in-app notification fan-out dedupe independently per night.
  kind    String   @default("webhook")
  sentAt  DateTime @default(now())

  @@unique([groupId, date, kind])
}

// One member's RSVP for one raid night. `date` is a calendar day string
// (YYYY-MM-DD) rather than a timestamp on purpose: the group's schedule
// stores its timezone as free text ("EST"), so there's no reliable instant
// to anchor to — but everyone agrees on which *day* "Tuesday's raid" is.
// String form sorts correctly and sidesteps timezone drift entirely.
model RaidSignup {
  id        String   @id @default(cuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String
  status    String // in | late | out
  updatedAt DateTime @updatedAt

  @@unique([groupId, userId, date])
  @@index([groupId, date])
}

model GroupMember {
  id       String   @id @default(cuid())
  groupId  String
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // "leader" | "subleader" | "member" — at most one leader (kept in sync
  // with Group.leaderId) and at most one subleader, enforced in the route
  // layer, not the DB.
  role     String   @default("member")
  // In-game guild rank name (e.g. "Officer"), stamped by rank sync on
  // guild groups; always null for hand-made statics.
  guildRank String?
  joinedAt DateTime @default(now())

  @@unique([groupId, userId])
}

model GroupRequest {
  id        String   @id @default(cuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([groupId, userId])
}

// One GW2 character, either imported from the GW2 API (source="gw2",
// wholesale-replaced on every sync) or added manually (source="manual",
// survives syncs untouched).
model Character {
  id         String              @id @default(cuid())
  userId     String
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  profession String
  race       String?
  source     String              @default("manual")
  // GW2 character name, stable across syncs when source="gw2".
  extId      String?
  activeTab  Int                 @default(1)
  createdAt  DateTime            @default(now())
  templates  CharacterTemplate[]
  slots      CompositionSlot[]

  @@unique([userId, name])
  @@index([userId])
}

// One GW2 build-storage tab (up to 9 per character). `assignedBuildId` is
// the player's own mapping of this loadout to a catalog build — GW2's API
// has no concept of the site's build catalog, so this is set manually.
model CharacterTemplate {
  id              String            @id @default(cuid())
  characterId     String
  character       Character         @relation(fields: [characterId], references: [id], onDelete: Cascade)
  tab             Int
  name            String?
  spec            String?
  isActive        Boolean           @default(false)
  assignedBuildId String?
  slots           CompositionSlot[]

  @@unique([characterId, tab])
}

model Composition {
  id          String            @id @default(cuid())
  groupId     String
  group       Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name        String
  fightName   String?
  createdById String
  createdBy   User              @relation(fields: [createdById], references: [id])
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  slots       CompositionSlot[]
  weekPlanItems GroupWeekPlanItem[]

  @@index([groupId])
}

model CompositionSlot {
  id                  String             @id @default(cuid())
  compositionId       String
  composition         Composition        @relation(fields: [compositionId], references: [id], onDelete: Cascade)
  subgroup            Int
  slotIndex           Int
  role                String
  profession          String
  spec                String?
  buildName           String?
  buildDetails        String?
  // Structured fields, preferred over the free-text ones above when the
  // slot was filled by picking a real catalog build / character rather
  // than typing a description by hand.
  buildId             String?
  // A hand-typed player name for someone being filled in manually (not a
  // synced group character). Ignored when characterId is set — the real
  // character's name wins.
  manualName          String?
  characterId         String?
  character           Character?         @relation(fields: [characterId], references: [id], onDelete: SetNull)
  characterTemplateId String?
  characterTemplate   CharacterTemplate? @relation(fields: [characterTemplateId], references: [id], onDelete: SetNull)

  @@unique([compositionId, subgroup, slotIndex])
}

model UploadJob {
  id           String   @id @default(cuid())
  status       String // queued | parsing | success | failed
  fileName     String
  fileSizeByte Int
  errorMessage String?
  logId        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// One row per privileged admin action (deletes, promotions, suspensions,
// guild interventions) — who did what to which record, when. Append-only;
// nothing in the app ever updates or deletes these.
model AdminAudit {
  id         String   @id @default(cuid())
  adminId    String
  admin      User     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  action     String
  targetType String
  targetId   String?
  detail     Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

// Site-wide announcement / message-of-the-day. Every page shows active,
// unexpired announcements in a banner under the nav; expiry is a hard
// cutoff (null = shown until deleted). severity: info | warning | critical.
model Announcement {
  id          String    @id @default(cuid())
  message     String
  severity    String    @default("info")
  expiresAt   DateTime?
  createdById String
  createdBy   User      @relation("AnnouncementAuthor", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@index([expiresAt])
}

// Feature switches / runtime config, read at request time so flipping one
// never needs a redeploy. Values are strings; each key's parsing lives in
// lib/appConfig.ts.
model AppConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
