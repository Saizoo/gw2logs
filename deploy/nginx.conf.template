# Copy to /etc/nginx/sites-available/gw2logs, replace __DOMAIN__, then:
#   ln -s /etc/nginx/sites-available/gw2logs /etc/nginx/sites-enabled/gw2logs
#   nginx -t && systemctl reload nginx
#   certbot --nginx -d __DOMAIN__   (adds the HTTPS server block automatically)

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    root /var/www/gw2logs;
    index index.html;

    # Uploaded logs can be tens of MB
    client_max_body_size 64m;

    location /api/ {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}
