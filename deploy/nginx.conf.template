# Copy to /etc/nginx/sites-available/gw2logs, replace __DOMAIN__, then:
#   ln -s /etc/nginx/sites-available/gw2logs /etc/nginx/sites-enabled/gw2logs
#   nginx -t && systemctl reload nginx
#   certbot --nginx -d __DOMAIN__   (adds the HTTPS server block automatically)

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    root /var/www/gw2logs;
    index index.html;

    # Security headers, applied to every response this server block emits.
    # `always` sends them on error responses too. HSTS is ignored by browsers
    # over plain HTTP, so it's harmless here and takes effect once certbot adds
    # the 443 block. frame-ancestors 'none' (+ X-Frame-Options for old
    # browsers) blocks clickjacking; nosniff stops MIME-type confusion.
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "frame-ancestors 'none'" always;

    # Raw .evtc/.zevtc uploads from big raid squads run 100-160MB — keep in
    # lockstep with the multer fileSize limit in server/src/routes/uploads.ts.
    client_max_body_size 200m;

    gzip on;
    gzip_vary on;
    gzip_comp_level 5;
    gzip_min_length 512;
    gzip_types text/plain text/css application/json application/javascript text/javascript text/xml application/xml image/svg+xml;

    location /api/ {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Matches EI_TIMEOUT_MS in eliteInsights.ts — a 160MB raid log takes
        # meaningfully longer to parse than the small fixtures this was
        # originally tuned against.
        proxy_read_timeout 300s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}
